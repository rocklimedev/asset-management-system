# Reusable CDN storage: local (mounted volume) or http (HTTPS object API).
CDN_STORAGE_DRIVER=local
CDN_STORAGE_ROOT=./storage/cdn
# Configure your reverse proxy/static server to serve CDN_STORAGE_ROOT at this URL.
CDN_PUBLIC_BASE_URL=https://cdn.example.com
# HTTP driver credentials (placeholders; unused by the local driver).
# This API must accept PUT/DELETE /<key> with Bearer auth; see src/modules/cdn/README.md.
CDN_API_URL=https://storage-api.example.com/objects
CDN_API_TOKEN=replace-with-your-cdn-api-token

# Zoho OAuth / employee communication (India defaults). See ZOHO_COMMUNICATION.md.
ZOHO_DATA_CENTER=in
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://mail.zoho.in
ZOHO_CLIQ_BASE_URL=https://cliq.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:4000/api/integrations/zoho/auth/callback
ZOHO_ORGANIZATION_ID=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZOHO_TOKEN_ENCRYPTION_KEY=
ZOHO_ADDITIONAL_SCOPES=
# Enable only if your organization allows Cliq admin API invitations.
ZOHO_CLIQ_ALLOW_CREATE=false
COMMUNICATION_COMPANY_DOMAINS=
COMMUNICATION_EMAIL_PATTERN={first}.{last}
