# Reusable CDN storage: local (mounted volume) or http (HTTPS object API).
CDN_STORAGE_DRIVER=local
CDN_STORAGE_ROOT=./storage/cdn
# Configure your reverse proxy/static server to serve CDN_STORAGE_ROOT at this URL.
CDN_PUBLIC_BASE_URL=https://cdn.example.com
# HTTP driver credentials (placeholders; unused by the local driver).
# This API must accept PUT/DELETE /<key> with Bearer auth; see src/modules/cdn/README.md.
CDN_API_URL=https://storage-api.example.com/objects
CDN_API_TOKEN=replace-with-your-cdn-api-token
