generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  EXITED
}

enum AssetKind {
  HARDWARE
  SOFTWARE
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  REPAIR
  LOST
  DAMAGED
  RETIRED
  DISPOSED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

// ============================================================
// ORGANISATIONS
// ============================================================

model Organisation {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String?  @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)

  employees   Employee[]
  categories  AssetCategory[]
  assets      Asset[]
  locations   Location[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("organisations")
}

// ============================================================
// CORE ORG
// ============================================================

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique

  employees Employee[]

  createdAt DateTime   @default(now())

  @@map("departments")
}

model Location {
  id             Int          @id @default(autoincrement())
  name           String       @unique

  organisationId Int?
  organisation   Organisation? @relation(
    fields: [organisationId],
    references: [id]
  )

  employees      Employee[]
  assets         Asset[]

  createdAt      DateTime     @default(now())

  @@index([organisationId])
  @@map("locations")
}

model Employee {
  id             Int            @id @default(autoincrement())
  employeeCode   String         @unique
  name           String
  email          String         @unique
  phone          String?
  avatarUrl      String?

  organisationId Int?
  organisation   Organisation?  @relation(
    fields: [organisationId],
    references: [id]
  )

  departmentId   Int?
  department     Department?    @relation(
    fields: [departmentId],
    references: [id]
  )

  designation    String?

  managerId      Int?
  manager        Employee?      @relation(
    "EmployeeManager",
    fields: [managerId],
    references: [id]
  )

  reports        Employee[]     @relation("EmployeeManager")

  locationId     Int?
  location       Location?      @relation(
    fields: [locationId],
    references: [id]
  )

  status         EmployeeStatus @default(ACTIVE)
  joiningDate    DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  assignments    AssetAssignment[]
  transfersFrom  AssetTransfer[] @relation("TransferFrom")
  transfersTo    AssetTransfer[] @relation("TransferTo")

  @@index([organisationId])
  @@index([departmentId])
  @@index([locationId])
  @@index([status])
  @@map("employees")
}

// ============================================================
// RBAC
// ============================================================

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  description String

  roles       RolePermission[]

  @@map("permissions")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model RolePermission {
  roleId       Int
  permissionId Int

  role         Role       @relation(
    fields: [roleId],
    references: [id],
    onDelete: Cascade
  )

  permission   Permission @relation(
    fields: [permissionId],
    references: [id],
    onDelete: Cascade
  )

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String

  roleId       Int
  role         Role       @relation(
    fields: [roleId],
    references: [id]
  )

  status       UserStatus @default(ACTIVE)

  employeeId   Int?       @unique

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs    AuditLog[]

  approvals    AssetTransfer[] @relation("Approver")
  requested    AssetTransfer[] @relation("Requester")

  @@map("users")
}

// ============================================================
// ASSET CATEGORIES
// ============================================================

model AssetCategory {
  id             Int          @id @default(autoincrement())

  name           String

  description    String?      @db.Text

  type           AssetKind

  organisationId Int
  organisation   Organisation @relation(
    fields: [organisationId],
    references: [id],
    onDelete: Cascade
  )

  isActive       Boolean      @default(true)

  assets         Asset[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  /*
   * Prevent:
   *
   * Rippotai -> Laptop
   * Rippotai -> Laptop
   *
   * But allow:
   *
   * Rippotai -> Laptop
   * Another Org -> Laptop
   */

  @@unique([organisationId, name])

  @@index([organisationId])
  @@index([type])
  @@index([isActive])

  @@map("asset_categories")
}

// ============================================================
// VENDORS
// ============================================================

model Vendor {
  id        Int     @id @default(autoincrement())
  name      String  @unique

  assets    Asset[]

  createdAt DateTime @default(now())

  @@map("vendors")
}

// ============================================================
// ASSETS
// ============================================================

model Asset {
  id              Int            @id @default(autoincrement())

  /*
   * Internal asset identifier.
   *
   * Example:
   * RIP-LAP-001
   */

  assetTag        String         @unique

  /*
   * Human readable name.
   *
   * Examples:
   * LEGION ( MOTHERBOARD DEAD )
   * LG - 22MP57HQ - P
   * Logitech - B100
   */

  name            String

  kind            AssetKind

  // ----------------------------------------------------------
  // ORGANISATION
  // ----------------------------------------------------------

  organisationId  Int
  organisation    Organisation   @relation(
    fields: [organisationId],
    references: [id],
    onDelete: Restrict
  )

  // ----------------------------------------------------------
  // CATEGORY
  // ----------------------------------------------------------

  categoryId      Int
  category        AssetCategory  @relation(
    fields: [categoryId],
    references: [id],
    onDelete: Restrict
  )

  // ----------------------------------------------------------
  // HARDWARE INFORMATION
  // ----------------------------------------------------------

  manufacturer    String?
  model           String?

  serialNumber    String?        @unique

  // ----------------------------------------------------------
  // PURCHASE
  // ----------------------------------------------------------

  purchaseDate    DateTime?

  purchasePrice   Decimal?       @db.Decimal(12, 2)

  vendorId        Int?
  vendor          Vendor?        @relation(
    fields: [vendorId],
    references: [id]
  )

  invoiceNumber   String?

  // ----------------------------------------------------------
  // WARRANTY
  // ----------------------------------------------------------

  warrantyStart   DateTime?
  warrantyExpiry  DateTime?

  // ----------------------------------------------------------
  // STATUS
  // ----------------------------------------------------------

  status          AssetStatus    @default(AVAILABLE)

  condition       AssetCondition @default(GOOD)

  // ----------------------------------------------------------
  // LOCATION
  // ----------------------------------------------------------

  locationId      Int?
  location        Location?      @relation(
    fields: [locationId],
    references: [id]
  )

  // ----------------------------------------------------------
  // NOTES
  // ----------------------------------------------------------

  notes           String?        @db.Text

  // ----------------------------------------------------------
  // RELATIONSHIPS
  // ----------------------------------------------------------

  license         SoftwareLicense?

  assignments     AssetAssignment[]

  transfers       AssetTransfer[]

  history         AssetHistory[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organisationId])
  @@index([categoryId])
  @@index([status])
  @@index([kind])
  @@index([locationId])

  @@map("assets")
}

// ============================================================
// SOFTWARE LICENSE
// ============================================================

model SoftwareLicense {
  id               Int      @id @default(autoincrement())

  assetId          Int      @unique

  asset            Asset    @relation(
    fields: [assetId],
    references: [id],
    onDelete: Cascade
  )

  vendor           String

  licenseType      String

  /*
   * Keep this protected at API/service layer.
   */

  licenseReference String

  totalSeats       Int      @default(1)

  assignedSeats    Int      @default(0)

  purchaseDate     DateTime?

  expiryDate       DateTime?

  renewalDate      DateTime?

  cost             Decimal? @db.Decimal(12, 2)

  @@map("software_licenses")
}

// ============================================================
// ASSET ASSIGNMENT
// ============================================================

/*
 * This is the inventory assignment table.
 *
 * Assigned:
 *
 * Asset
 *   ↓
 * AssetAssignment
 *   ↓
 * Employee
 *
 * Unassigned:
 *
 * Asset
 *   ↓
 * NO ACTIVE AssetAssignment
 *
 * Asset.status = AVAILABLE
 */

model AssetAssignment {
  id          Int              @id @default(autoincrement())

  assetId     Int
  asset       Asset            @relation(
    fields: [assetId],
    references: [id]
  )

  employeeId  Int
  employee    Employee         @relation(
    fields: [employeeId],
    references: [id]
  )

  assignedAt  DateTime         @default(now())

  returnedAt  DateTime?

  assignedBy  Int

  status      AssignmentStatus @default(ACTIVE)

  notes       String?

  @@index([assetId, status])
  @@index([employeeId, status])

  @@map("asset_assignments")
}

// ============================================================
// ASSET TRANSFER
// ============================================================

model AssetTransfer {
  id             Int            @id @default(autoincrement())

  assetId        Int

  asset          Asset          @relation(
    fields: [assetId],
    references: [id]
  )

  // ----------------------------------------------------------
  // FROM EMPLOYEE
  // ----------------------------------------------------------

  fromEmployeeId Int?

  fromEmployee   Employee?      @relation(
    "TransferFrom",
    fields: [fromEmployeeId],
    references: [id]
  )

  // ----------------------------------------------------------
  // TO EMPLOYEE
  // ----------------------------------------------------------

  toEmployeeId   Int

  toEmployee     Employee       @relation(
    "TransferTo",
    fields: [toEmployeeId],
    references: [id]
  )

  // ----------------------------------------------------------
  // REQUEST
  // ----------------------------------------------------------

  requestedById  Int

  requestedBy    User           @relation(
    "Requester",
    fields: [requestedById],
    references: [id]
  )

  // ----------------------------------------------------------
  // APPROVAL
  // ----------------------------------------------------------

  approvedById   Int?

  approvedBy     User?          @relation(
    "Approver",
    fields: [approvedById],
    references: [id]
  )

  // ----------------------------------------------------------
  // STATUS
  // ----------------------------------------------------------

  status         TransferStatus @default(COMPLETED)

  reason         String?

  notes          String?

  createdAt      DateTime       @default(now())

  approvedAt     DateTime?

  @@index([assetId])
  @@index([fromEmployeeId])
  @@index([toEmployeeId])
  @@index([status])

  @@map("asset_transfers")
}

// ============================================================
// ASSET HISTORY
// ============================================================

model AssetHistory {
  id           Int      @id @default(autoincrement())

  assetId      Int

  asset        Asset    @relation(
    fields: [assetId],
    references: [id]
  )

  /*
   * ASSIGNED
   * TRANSFERRED
   * STATUS_CHANGED
   * RETURNED
   * RETIRED
   * CREATED
   * UPDATED
   */

  action       String

  performedBy  String

  fromValue    String?

  toValue      String?

  notes        String?

  createdAt    DateTime @default(now())

  @@index([assetId])
  @@index([createdAt])

  @@map("asset_history")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id        Int      @id @default(autoincrement())

  userId    Int?

  user      User?    @relation(
    fields: [userId],
    references: [id]
  )

  action    String

  entity    String

  entityId  String

  metadata  Json?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])

  @@map("audit_logs")
}

// ============================================================
// SETTINGS
// ============================================================

model Setting {
  key   String @id
  value Json

  @@map("settings")
}